{
  "expo": {
    "name": "FinGist",
    "slug": "fingist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fingist",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#eef3fb",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sandippatel.fingist",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.sandippatel.fingist",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#01208e"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#eef3fb",
          "ios": {
            "image": "./assets/splash-full.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover",
            "backgroundColor": "#eef3fb"
          },
          "android": {
            "image": "./assets/splash-blank.png",
            "imageWidth": 64,
            "backgroundColor": "#eef3fb"
          }
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#01208e"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://fingist-api.fingist-sandip.workers.dev",
      "websiteUrl": "https://fingist-api.fingist-sandip.workers.dev",
      "privacyUrl": "https://fingist-api.fingist-sandip.workers.dev/privacy",
      "termsUrl": "https://fingist-api.fingist-sandip.workers.dev/terms",
      "eas": {
        "projectId": "464a8727-5cad-4240-8155-8bbb2da6a5c9"
      },
      "supportEmail": "sandypatel8889@gmail.com",
      "iosAppStoreId": ""
    }
  }
}
