{
  "expo": {
    "name": "FinGist",
    "slug": "fingist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fingist",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#01208e",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sandippatel.fingist",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.sandippatel.fingist",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#01208e"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 64,
          "resizeMode": "contain",
          "backgroundColor": "#01208e"
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#01208e"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://fingist-api.fingist-sandip.workers.dev",
      "websiteUrl": "https://fingist.nrgroup.site",
      "privacyUrl": "https://fingist.nrgroup.site/privacy.html",
      "termsUrl": "https://fingist.nrgroup.site/terms.html",
      "eas": {
        "projectId": "464a8727-5cad-4240-8155-8bbb2da6a5c9"
      },
      "supportEmail": "sandypatel8889@gmail.com",
      "iosAppStoreId": ""
    }
  }
}
