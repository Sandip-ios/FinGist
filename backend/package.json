{
  "name": "fingist-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler d1 migrations apply fingist --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fingist --local",
    "db:migrate:remote": "wrangler d1 migrations apply fingist --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "update-tickers": "tsx scripts/update-tickers.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
